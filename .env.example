# VisionTalk AI Environment Configuration
# Copy this file to .env and set your Google Gemini API key:
# cp .env.example .env

# Google Gemini API Key (Required for multi-modal conversational answers)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: YOLOv8 default confidence threshold (default: 0.25)
YOLO_CONF_THRESHOLD=0.25
